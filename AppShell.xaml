<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LoginWithFirebase.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:LoginWithFirebase"
    xmlns:views="clr-namespace:LoginWithFirebase.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="LoginWithFirebase">


    <ShellContent
    Title="Sign in"
    ContentTemplate="{DataTemplate views:SignInPage}"
    Route="MainPage" />
    
    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />


    <FlyoutItem Title="Home" Icon="logo.png">
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>


    <ShellContent 
        Title="Chat" 
        ContentTemplate="{DataTemplate views:ChatPage}" 
        Shell.NavBarIsVisible="False" />

</Shell>
