<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LoginWithFirebase.ViewModel"
             xmlns:handlers="clr-namespace:LoginWithFirebase.Handlers"
             x:Class="LoginWithFirebase.Views.SignInPage"
             x:DataType="vm:SignInViewModel"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#E0F7FA" 
    NavigationPage.HasNavigationBar="False"
    
    Padding="0">
    

    <Grid RowDefinitions="*,Auto" Padding="30,20" BackgroundColor="#E0F7FA">
        

        
        <VerticalStackLayout
            Spacing="20"
            VerticalOptions="StartAndExpand">
            

            
            <Image Source="logo.png"
                   HeightRequest="150"
                   WidthRequest="150"
                   HorizontalOptions="Center"/>

           
            <Label Text="Prijava"
                   Style="{StaticResource GlobalFontStyle}"
                   FontSize="22"
                   TextColor="#333333"
                   HorizontalTextAlignment="Center"
                   FontAttributes="Bold"/>

            
            <Grid Padding="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    
                    <ColumnDefinition Width="*"/>
                    
                </Grid.ColumnDefinitions>

                <Frame BackgroundColor="White"
                       BorderColor="#E0E0E0"
                       CornerRadius="25" 
                    HeightRequest="50"
                       WidthRequest="50"
                  
                    VerticalOptions="Center"
                       HorizontalOptions="Center"
                       Padding="0">
                    
                    <Image Source="email.png"
                           HeightRequest="20"
                           WidthRequest="20"
                           HorizontalOptions="Center" 
                        VerticalOptions="Center"/>
                        
                </Frame>

                <Entry Grid.Column="1"
                       Style="{StaticResource GlobalFontStyle}"
                       Text="{Binding SignInModel.Email}"
                       Placeholder="Email"
                       Keyboard="Email"
                       BackgroundColor="Transparent" 
                    PlaceholderColor="#A0A0A0"
                       TextColor="#333333"
                       FontSize="16"
                       Margin="10,0,0,0"
                       VerticalOptions="Center"
                       AutomationProperties.HelpText="User Email"/>
            </Grid>

            
            <Grid Padding="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                  
                    <ColumnDefinition Width="*"/>
                    
                </Grid.ColumnDefinitions>

                <Frame BackgroundColor="White"
                       BorderColor="#E0E0E0"
                       CornerRadius="25" 
                    HeightRequest="50"
                       WidthRequest="50"
                    VerticalOptions="Center"
                       HorizontalOptions="Center"
                       Padding="0">
                    <Image Source="password.png"
                           HeightRequest="20"
                           WidthRequest="20"
                           HorizontalOptions="Center" 
                        VerticalOptions="Center"/>
                        
                </Frame>

                <Entry Grid.Column="1"
                       Style="{StaticResource GlobalFontStyle}"
                       Text="{Binding SignInModel.Password}"
                       Placeholder="Šifra"
                       IsPassword="True"
                       BackgroundColor="Transparent"
                    PlaceholderColor="#A0A0A0"
                       TextColor="#333333"
                       FontSize="16"
                       Margin="10,0,0,0"
                       VerticalOptions="Center"
                       AutomationProperties.HelpText="Password"/>
            </Grid>

            
            <StackLayout Orientation="Horizontal"
                         HorizontalOptions="End"
                         Padding="0,5,0,0">
                <Label Text="Zaboravili ste šifru?"
                       Style="{StaticResource GlobalFontStyle}"
                       TextColor="#007AFF"
                       VerticalOptions="Center"
                       FontAttributes="Bold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </StackLayout>

            
            <StackLayout Orientation="Horizontal"
                         HorizontalOptions="Center"
                         Padding="0,10,0,0">
                <CheckBox IsChecked="{Binding RememberMe}" Color="#007AFF"/>
                <Label Text="Zapamti me"
                       Style="{StaticResource GlobalFontStyle}"
                       VerticalOptions="Center"
                       TextColor="#333333"/>
            </StackLayout>

            
            <Button Text="Prijavi se"
                    Style="{StaticResource GlobalFontStyle}"
                    BackgroundColor="#007AFF"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="25"
                    HeightRequest="50"
                    HorizontalOptions="FillAndExpand"
                    Command="{Binding SignInCommand}"
                    AutomationProperties.HelpText="Sign In">
                <Button.Triggers>
                    <Trigger TargetType="Button" Property="IsPressed" Value="True">
                        <Setter Property="BackgroundColor" Value="#005BBB"/>
                       
                    </Trigger>
                </Button.Triggers>
            </Button>
        </VerticalStackLayout>

        
        <HorizontalStackLayout
            Grid.Row="1"
            Spacing="10" 
            HorizontalOptions="Center"
            Padding="0,15,0,0">
            <Label Text="Nemaš korisnički račun? " 
                   Style="{StaticResource GlobalFontStyle}"
                TextColor="#666666"
                   VerticalOptions="Center"/>

                <Button Text="Registracija"
                    Style="{StaticResource ButtonStyle}"
                    BackgroundColor="Transparent"
                    TextColor="#007AFF"
                    FontAttributes="Bold"
                    Command="{Binding NavigateSignUpCommand}"
                    VerticalOptions="Center"
                    FontSize="16"
                    Padding="0,0">
                    <Button.Triggers>
                        <Trigger TargetType="Button" Property="IsPressed" Value="True">
                            <Setter Property="TextColor" Value="#005BBB"/>
                            
                        </Trigger>
                    </Button.Triggers>
                </Button>
        </HorizontalStackLayout>

    </Grid>
</ContentPage>
