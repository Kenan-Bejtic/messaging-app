<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LoginWithFirebase.Views.GroupChatPage"
             Title="Group Chat Page"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#E0F7FA" 
             NavigationPage.HasNavigationBar="False"
             Padding="0">

    <Grid RowDefinitions="Auto,*,Auto" Padding="30,20" BackgroundColor="#E0F7FA">
        <VerticalStackLayout Grid.Row="0" Spacing="10" BackgroundColor="#E0F7FA" HorizontalOptions="FillAndExpand" VerticalOptions="Start">
            <Image Source="logo.png"
                   HeightRequest="150"
                   WidthRequest="150"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

      
        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Spacing="25"
                VerticalOptions="StartAndExpand"
                Padding="20">

                <Label Text="Kreiranje novog grupnog razgovora"
                       Style="{StaticResource GlobalFontStyle}"
                       FontAttributes="Bold" 
                       FontSize="18"
                       TextColor="#333333" />

                <Grid Padding="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Frame BackgroundColor="White"
                           BorderColor="#E0E0E0"
                           CornerRadius="25"
                           HeightRequest="50"
                           WidthRequest="50"
                           VerticalOptions="Center"
                           HorizontalOptions="Start"
                           Padding="0">
                        <Image Source="groupchat.png" 
                               HeightRequest="20"
                               WidthRequest="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Frame>

                    <Entry Grid.Column="1"
                           x:Name="GroupNameEntry"
                           Style="{StaticResource GlobalFontStyle}"
                           Placeholder="Unesite ime grupe..."
                           BackgroundColor="Transparent"
                           PlaceholderColor="#A0A0A0"
                           TextColor="#333333"
                           FontSize="16"
                           Margin="10,0,0,0"
                           VerticalOptions="Center"
                           AutomationProperties.HelpText="Group Name"/>
                </Grid>

                <Button Text="Kreiraj grupu"
                        Style="{StaticResource ButtonStyle}"
                        BackgroundColor="#388E3C" 
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="25"
                        HeightRequest="50"
                        HorizontalOptions="FillAndExpand"
                        Clicked="OnCreateGroupClicked">
                    <Button.Triggers>
                        <Trigger TargetType="Button" Property="IsPressed" Value="True">
                            <Setter Property="BackgroundColor" Value="#2E7D32"/>
                        </Trigger>
                    </Button.Triggers>
                </Button>

                <BoxView HeightRequest="1" Color="Gray" />

                <Label Text="Pridruži se grupi" 
                       Style="{StaticResource GlobalFontStyle}"
                       FontAttributes="Bold" 
                       FontSize="18"
                       TextColor="#333333" />

                <Grid Padding="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Frame BackgroundColor="White"
                           BorderColor="#E0E0E0"
                           CornerRadius="25"
                           HeightRequest="50"
                           WidthRequest="50"
                           VerticalOptions="Center"
                           HorizontalOptions="Start"
                           Padding="0">
                        <Image Source="search.png" 
                               HeightRequest="20"
                               WidthRequest="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Frame>

                    <Entry Grid.Column="1"
                           x:Name="GroupIdEntry"
                           Placeholder="Unesite ID grupnog razgovora..."
                           Style="{StaticResource GlobalFontStyle}"
                           BackgroundColor="Transparent"
                           PlaceholderColor="#A0A0A0"
                           TextColor="#333333"
                           FontSize="16"
                           Margin="10,0,0,0"
                           VerticalOptions="Center"
                           AutomationProperties.HelpText="Group Chat ID"/>
                </Grid>

                <Button Text="Priduži se grupi"
                        Style="{StaticResource ButtonStyle}"
                        BackgroundColor="#1976D2" 
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="25"
                        HeightRequest="50"
                        HorizontalOptions="FillAndExpand"
                        Clicked="OnJoinGroupClicked">
                    <Button.Triggers>
                        <Trigger TargetType="Button" Property="IsPressed" Value="True">
                            <Setter Property="BackgroundColor" Value="#1565C0"/>
                        </Trigger>
                    </Button.Triggers>
                </Button>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
