
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LoginWithFirebase.Views.GroupChatPage"
             Title="Group Chat Page">


    <VerticalStackLayout Spacing="20" Padding="20">

        <Label Text="Create New Group Chat" 
               FontAttributes="Bold" 
               FontSize="18" />

        <Entry x:Name="GroupNameEntry"
               Placeholder="Enter new group name..."
               FontSize="14" />

        <Button Text="Create Group"
                BackgroundColor="#388E3C" 
                TextColor="White"
                Clicked="OnCreateGroupClicked"/>


        <BoxView HeightRequest="1" Color="Gray" />

        <Label Text="Join Existing Group Chat" 
               FontAttributes="Bold" 
               FontSize="18" />

        <Entry x:Name="GroupIdEntry"
               Placeholder="Enter group chat ID..."
               FontSize="14" />

        <Button Text="Join Group"
                BackgroundColor="#1976D2" 
                TextColor="White"
                Clicked="OnJoinGroupClicked"/>
    </VerticalStackLayout>
</ContentPage>
