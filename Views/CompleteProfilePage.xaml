<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LoginWithFirebase.ViewModel"
             x:Class="LoginWithFirebase.Views.CompleteProfilePage"
             x:DataType="vm:CompleteProfileViewModel"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#E0F7FA" 
             NavigationPage.HasNavigationBar="False"
             Padding="0">

    <Grid RowDefinitions="*,Auto" Padding="30,20" BackgroundColor="#E0F7FA">

        <VerticalStackLayout
            Spacing="25"
            VerticalOptions="StartAndExpand">

            <Image Source="logo.png"
                   HeightRequest="150"
                   WidthRequest="150"
                   HorizontalOptions="Center"/>

            <Label Text="Kompletirajte svoj profil"
                   FontSize="22"
                   TextColor="#333333"
                   HorizontalTextAlignment="Center"
                   FontAttributes="Bold"/>

            <Grid Padding="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Frame BackgroundColor="White"
                       BorderColor="#E0E0E0"
                       CornerRadius="25"
                       HeightRequest="50"
                       WidthRequest="50"
                       VerticalOptions="Center"
                       HorizontalOptions="Start"
                       Padding="0">
                    <Image Source="user_logo.png"
                           HeightRequest="20"
                           WidthRequest="20"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Frame>

                <Entry Grid.Column="1"
                       Text="{Binding Username}"
                       Placeholder="Korisničko ime"
                       BackgroundColor="Transparent"
                       PlaceholderColor="#A0A0A0"
                       TextColor="#333333"
                       FontSize="16"
                       Margin="10,0,0,0"
                       VerticalOptions="Center"
                       AutomationProperties.HelpText="Username"/>
            </Grid>

            <Grid Padding="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Frame BackgroundColor="White"
                       BorderColor="#E0E0E0"
                       CornerRadius="25"
                       HeightRequest="50"
                       WidthRequest="50"
                       VerticalOptions="Center"
                       HorizontalOptions="Start"
                       Padding="0">
                    <Image Source="gender.png"
                           HeightRequest="20"
                           WidthRequest="20"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Frame>

                <Picker Grid.Column="1"
                        Title="Odaberite spol"
                        ItemsSource="{Binding Genders}"
                        SelectedItem="{Binding Gender}"
                        BackgroundColor="Transparent"
                        TextColor="#333333"
                        FontSize="16"
                        Margin="10,0,0,0"
                        VerticalOptions="Center"
                        AutomationProperties.HelpText="Gender"/>
            </Grid>

            <Button Text="Upload profilne slike"
                    BackgroundColor="#007AFF"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="25"
                    HeightRequest="50"
                    HorizontalOptions="FillAndExpand"
                    Command="{Binding UploadProfilePictureCommand}"
                    AutomationProperties.HelpText="Upload Profile Picture">
                <Button.Triggers>
                    <Trigger TargetType="Button" Property="IsPressed" Value="True">
                        <Setter Property="BackgroundColor" Value="#005BBB"/>
                    </Trigger>
                </Button.Triggers>
            </Button>

            <Button Text="Kreiraj profil"
                    BackgroundColor="#007AFF"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="25"
                    HeightRequest="50"
                    HorizontalOptions="FillAndExpand"
                    Command="{Binding CompleteProfileCommand}"
                    AutomationProperties.HelpText="Complete Profile">
                <Button.Triggers>
                    <Trigger TargetType="Button" Property="IsPressed" Value="True">
                        <Setter Property="BackgroundColor" Value="#005BBB"/>
                    </Trigger>
                </Button.Triggers>
            </Button>
        </VerticalStackLayout>

       

    </Grid>
</ContentPage>
