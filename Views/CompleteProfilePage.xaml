<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LoginWithFirebase.Views.CompleteProfilePage"
             Title="Complete Your Profile">
    <StackLayout Padding="20">
        <Label Text="Username" />
        <Entry Text="{Binding Username}" />

        <Label Text="Gender" />
        <Picker Title="Select Gender" ItemsSource="{Binding Genders}" SelectedItem="{Binding Gender}" />

        <Button Text="Upload Profile Picture" Command="{Binding UploadProfilePictureCommand}" />

        <Button Text="Complete Profile" Command="{Binding CompleteProfileCommand}" />
    </StackLayout>
</ContentPage>
