<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="LoginWithFirebase.Views.FriendInvitationPage"
    x:Name="InvitationPage"  
    Title="Search User"
    BackgroundColor="#E0F7FA"
    NavigationPage.HasNavigationBar="False">

   
    <Grid Padding="30,20"
          BackgroundColor="#E0F7FA">

        <Grid.RowDefinitions>
            
            <RowDefinition Height="Auto" />
           
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

       
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="25"
            VerticalOptions="Start"
            BackgroundColor="#E0F7FA">

            
            <Image Source="logo.png"
                   HeightRequest="150"
                   WidthRequest="150"
                   HorizontalOptions="Center" />

            
            <Label Text="Pretraži korisnika"
                   Style="{StaticResource GlobalFontStyle}"
                   FontSize="22"
                   TextColor="#333333"
                   HorizontalTextAlignment="Center"
                   FontAttributes="Bold" />

            <Grid Padding="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                
                <Frame BackgroundColor="White"
                       BorderColor="#E0E0E0"
                       CornerRadius="25"
                       HeightRequest="50"
                       WidthRequest="50"
                       VerticalOptions="Center"
                       HorizontalOptions="Start"
                       Padding="0">
                    <Image Source="user_logo.png"
                           HeightRequest="20"
                           WidthRequest="20"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Frame>

                
                <SearchBar Grid.Column="1"
                           x:Name="InviteCodeSearchBar"
                           Placeholder="Unesite ID korisnika"
                           Text="{Binding EnteredInviteCode}"
                           BackgroundColor="Transparent"
                           PlaceholderColor="#A0A0A0"
                           TextColor="#333333"
                           FontSize="16"
                           Margin="10,0,0,0"
                           VerticalOptions="Center"
                           AutomationProperties.HelpText="Enter Invite Code"
                           SearchCommand="{Binding SearchCommand}"
                           SearchCommandParameter="{Binding Text, Source={x:Reference InviteCodeSearchBar}}" />
            </Grid>

            
            <Button Text="Pretraga"
                    Style="{StaticResource ButtonStyle}"
                    BackgroundColor="#007AFF"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="25"
                    HeightRequest="60"
                    HorizontalOptions="FillAndExpand"
                    Command="{Binding SearchCommand}"
                    CommandParameter="{Binding EnteredInviteCode}"
                    AutomationProperties.HelpText="Search">
                <Button.Triggers>
                    <Trigger TargetType="Button" Property="IsPressed" Value="True">
                        <Setter Property="BackgroundColor" Value="#005BBB"/>
                    </Trigger>
                </Button.Triggers>
            </Button>

            
            <StackLayout IsVisible="{Binding IsProfileVisible}"
                         Margin="0,30,0,0">

               
                <Frame BackgroundColor="White"
                       BorderColor="#E0E0E0"
                       CornerRadius="20"
                       Padding="20"
                       HasShadow="True"
                       HorizontalOptions="FillAndExpand">
                    <HorizontalStackLayout Spacing="20" VerticalOptions="Center">
                       
                        <Image Source="{Binding ProfilePictureUrl}"
                               WidthRequest="100"
                               HeightRequest="100"
                               Aspect="AspectFill"
                               VerticalOptions="Center"
                               HorizontalOptions="Start" />

                       
                        <Label Text="{Binding Username}"
                               FontAttributes="Bold"
                               FontSize="24"
                               TextColor="#333333"
                               VerticalOptions="Center"
                               HorizontalOptions="Start"
                               AutomationProperties.HelpText="Username"/>
                    </HorizontalStackLayout>
                </Frame>

                
                <Button Text="Pošalji zahtjev za prijateljstvo"
                        Style="{StaticResource ButtonStyle}"
                        BackgroundColor="#007AFF"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="25"
                        HeightRequest="60"
                        HorizontalOptions="FillAndExpand"
                        Margin="0,20,0,0"
                        Command="{Binding SendFriendRequestCommand}"
                        AutomationProperties.HelpText="Send Friend Request">
                    <Button.Triggers>
                        <Trigger TargetType="Button" Property="IsPressed" Value="True">
                            <Setter Property="BackgroundColor" Value="#005BBB"/>
                        </Trigger>
                    </Button.Triggers>
                </Button>
            </StackLayout>
        </VerticalStackLayout>
        
        
        <ListView Grid.Row="1"
          Margin="0,20,0,0"
          ItemsSource="{Binding PendingRequests}"
          SeparatorVisibility="None"
          HasUnevenRows="True"
          BackgroundColor="#E0F7FA">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Frame BackgroundColor="White"
                       CornerRadius="10"
                       Margin="10,5"
                       Padding="10">
                            
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                               
                                <StackLayout Grid.Row="0"
                                     Orientation="Horizontal"
                                     Spacing="10"
                                     VerticalOptions="Center">
                                    
                                    <Image Source="{Binding ProfilePictureUrl}"
                                   WidthRequest="50"
                                   HeightRequest="50"
                                   Aspect="AspectFill"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Start" />

                                    
                                    <StackLayout Orientation="Vertical"
                                         VerticalOptions="Center"
                                         HorizontalOptions="StartAndExpand">
                                        
                                        <Label Text="{Binding Username}"
                                       FontAttributes="Bold"
                                       Style="{StaticResource GlobalFontStyle}"
                                       TextColor="#333333"
                                       VerticalOptions="Center"
                                       LineBreakMode="NoWrap"
                                       MaxLines="1" />
                                        
                                        <Label Text="{Binding FromUserId}"
                                       FontSize="12"
                                       TextColor="Gray"
                                       VerticalOptions="Center" />
                                    </StackLayout>
                                </StackLayout>

                                
                                <StackLayout Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalOptions="Center"
                                Spacing="20"
                                VerticalOptions="Center">
                                   
                                    <Button Text="Prihvati"
                                    BackgroundColor="#28a745"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    Style="{StaticResource GlobalFontStyle}"
                                    CornerRadius="10"
                                    HeightRequest="50"
                                    WidthRequest="100"   
                                    Command="{Binding Path=BindingContext.AcceptFriendRequestCommand, Source={x:Reference InvitationPage}}"
                                    CommandParameter="{Binding FromUserId}"
                                    AutomationProperties.HelpText="Accept Friend Request">
                                        <Button.Triggers>
                                            <Trigger TargetType="Button" Property="IsPressed" Value="True">
                                                <Setter Property="BackgroundColor" Value="#218838" />
                                            </Trigger>
                                        </Button.Triggers>
                                    </Button>

                                    
                                    <Button Text="Obriši"
                                    BackgroundColor="#dc3545"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    Style="{StaticResource GlobalFontStyle}"
                                    CornerRadius="10"
                                    HeightRequest="50"
                                    WidthRequest="100"   
                                    Command="{Binding Path=BindingContext.DeleteFriendRequestCommand, Source={x:Reference InvitationPage}}"
                                    CommandParameter="{Binding FromUserId}"
                                    AutomationProperties.HelpText="Delete Friend Request">
                                        <Button.Triggers>
                                            <Trigger TargetType="Button" Property="IsPressed" Value="True">
                                                <Setter Property="BackgroundColor" Value="#c82333" />
                                            </Trigger>
                                        </Button.Triggers>
                                    </Button>
                                </StackLayout>

                            </Grid>
                        </Frame>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>



    </Grid>
</ContentPage>
