<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:LoginWithFirebase.Helpers"
             x:Class="LoginWithFirebase.App">
    <Application.Resources>
        <ResourceDictionary>
           
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            
            <helpers:BubbleAlignmentConverter x:Key="BubbleAlignmentConverter" />
            <helpers:BubbleBackgroundColorConverter x:Key="BubbleBackgroundColorConverter" />
            <helpers:NullOrEmptyToBoolConverter x:Key="NullOrEmptyToBoolConverter" />
            <helpers:NullOrEmptyToBoolInverter x:Key="NullOrEmptyToBoolInverter" />


            <Color x:Key="SentMessageColor">#DCF8C6</Color>
            <Color x:Key="ReceivedMessageColor">#FFFFFF</Color>
            <Color x:Key="HeaderBackgroundColor">#007AFF</Color>
            <Color x:Key="EntryBackgroundColor">#FFFFFF</Color>
            <Color x:Key="ButtonBackgroundColor">#007AFF</Color>
            <Color x:Key="ButtonPressedColor">#005BBB</Color>



            <Color x:Key="DarkSentMessageColor">#3E3E3E</Color>
            <Color x:Key="DarkReceivedMessageColor">#1C1C1E</Color>
            <Color x:Key="DarkHeaderBackgroundColor">#333333</Color>
            <Color x:Key="DarkEntryBackgroundColor">#1C1C1E</Color>
            <Color x:Key="DarkButtonBackgroundColor">#444444</Color>
            <Color x:Key="DarkButtonPressedColor">#555555</Color>

            <Style x:Key="GlobalFontStyle" TargetType="Label">
                <Setter Property="FontSize" Value="{DynamicResource GlobalFontSize}" />
            </Style>
            <Style x:Key="ButtonStyle" TargetType="Button">
                <Setter Property="FontSize" Value="{DynamicResource GlobalFontSize}" />
            </Style>
            <Style x:Key="EntryStyle" TargetType="Entry">
                <Setter Property="FontSize" Value="{DynamicResource GlobalFontSize}" />
            </Style>
            <x:Double x:Key="GlobalFontSize">16</x:Double>

            <Style x:Key="CircularImageStyle" TargetType="Image">
                <Setter Property="WidthRequest" Value="40"/>
                <Setter Property="HeightRequest" Value="40"/>
                <Setter Property="Aspect" Value="AspectFill"/>
                <Setter Property="Clip">
                    <Setter.Value>
                        <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20"/>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
