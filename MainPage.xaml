<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LoginWithFirebase.Model"
             x:Class="LoginWithFirebase.MainPage"
             Title="Home"
             BackgroundColor="#E0F7FA"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <Grid Grid.Row="0" BackgroundColor="#007AFF">
            <Image Source="logo.png"
                   HeightRequest="70"
                   WidthRequest="700"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Grid>

        <Grid Grid.Row="1">
            <ScrollView>
                <VerticalStackLayout Padding="20,10" Spacing="20">
                    <CollectionView x:Name="ChatsCollectionView"
                        ItemsSource="{Binding FriendList}"
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="local:FriendDisplayModel">
                                <Frame HasShadow="True"
             BorderColor="#E0E0E0"
             CornerRadius="10"
             Padding="10"
             Margin="5">

                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer 
              Command="{Binding BindingContext.ItemTappedCommand, Source={RelativeSource AncestorType={x:Type CollectionView}}}"
              CommandParameter="{Binding}" />
                                    </Frame.GestureRecognizers>

                                    <HorizontalStackLayout Spacing="15">

                                        <Frame WidthRequest="50"
                 HeightRequest="50"
                 CornerRadius="25"
                 IsClippedToBounds="True"
                 Padding="0"
                 BorderColor="Transparent">
                                            <Image Source="{Binding ProfilePictureUrl}" 
                   Aspect="AspectFill"
                                                    />
                                        </Frame>


                                        <Grid VerticalOptions="Center" HorizontalOptions="FillAndExpand">

                                            <Label Text="{Binding Username}"
                   
                                                   Style="{StaticResource GlobalFontStyle}"
                   FontAttributes="Bold"
                   TextColor="#007AFF"
                   VerticalOptions="Center"
                   HorizontalOptions="Start" />


                                            <Frame BackgroundColor="Red"
                   WidthRequest="18"
                   HeightRequest="18"
                   CornerRadius="9"
                   VerticalOptions="Center"
                   HorizontalOptions="End"
                   IsVisible="{Binding HasUnreadMessages}">
                                                <Label Text="!"
                     TextColor="White"
                     FontSize="12"
                     VerticalOptions="Center"
                     HorizontalOptions="Center" />
                                            </Frame>
                                        </Grid>
                                    </HorizontalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>



                </VerticalStackLayout>
            </ScrollView>

            <Grid HorizontalOptions="End" VerticalOptions="End" Margin="0,0,20,5">
                <Grid>
                    <ImageButton Source="user_logo.png"
                                 WidthRequest="60"
                                 HeightRequest="60"
                                 CornerRadius="30"
                                 BackgroundColor="Transparent"
                                 Clicked="OnProfileButtonClicked" />

                    <Frame IsVisible="{Binding HasPendingFriendRequests}"
                           BackgroundColor="Red"
                           BorderColor="Red"
                           CornerRadius="10"
                           WidthRequest="20"
                           HeightRequest="20"
                           HorizontalOptions="End"
                           VerticalOptions="Start"
                           Margin="0,-10,-5,0">
                        <Label Text="!"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               FontSize="12" />
                    </Frame>
                </Grid>
            </Grid>

            <StackLayout VerticalOptions="End" HorizontalOptions="Start" Margin="10">
                <Button Text="Grupni chat" 
                        Style="{StaticResource ButtonStyle}"
                    Clicked="OnGroupChatButtonClicked"
                    BackgroundColor="#1976D2" 
                    TextColor="White"
                    CornerRadius="20"
                    WidthRequest="120"
                    HeightRequest="50" />
            </StackLayout>
        </Grid>
    </Grid>
</ContentPage>